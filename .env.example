# Copy this file to .env.local and fill in values from Supabase > Project Settings > API.
# These two values are safe for browser use when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: used for canonical links/metadata after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put SUPABASE_SERVICE_ROLE_KEY in a NEXT_PUBLIC_ variable or commit it.
# If a future server-only task needs it, add it to Vercel Environment Variables
# and a local .env.local file only. Do not share it publicly.
